FROM node:20.18.0
WORKDIR /app

# Instalar pnpm via npm em vez de corepack
RUN npm install -g pnpm@9.1.0 wrangler

# Resto do Dockerfile sem mudanças...
COPY package.json pnpm-lock.yaml ./
RUN pnpm install
COPY . .
RUN tr -d '\r' < bindings.sh > bindings.tmp && \
    mv bindings.tmp bindings.sh && \
    chmod +x bindings.sh
RUN pnpm run build
EXPOSE 5173
ENV NODE_ENV=production \
    RUNNING_IN_DOCKER=true
CMD ["pnpm", "run", "dockerstart"]
